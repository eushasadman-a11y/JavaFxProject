<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>javafx:run</goal>
        </goals>
        <properties>
            <exec.mainClass>com.attendance.Launcher</exec.mainClass>
            <exec.vmArgs>--add-modules javafx.controls,javafx.fxml,javafx.swing,java.sql --enable-native-access=ALL-UNNAMED</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass}</exec.args>
            <exec.executable>java</exec.executable>
        </properties>
    </action>
    
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>javafx:run</goal>
        </goals>
        <properties>
            <exec.mainClass>com.attendance.Launcher</exec.mainClass>
            <exec.vmArgs>--add-modules javafx.controls,javafx.fxml,javafx.swing,java.sql --enable-native-access=ALL-UNNAMED -agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass}</exec.args>
            <exec.executable>java</exec.executable>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    
    <action>
        <actionName>rebuild</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>install</goal>
        </goals>
    </action>
</actions>