<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" styleClass="root" stylesheets="@../css/Style.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.attendance.controller.DepartmentController">
    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
    <children>
        <VBox>
            <Label text="Departments" textFill="#2C3E50"><font><Font name="System Bold" size="26.0" /></font></Label>
            <Label text="Manage academic or administrative units" textFill="#7F8C8D" />
        </VBox>

        <TextField fx:id="searchDept" prefHeight="40.0" promptText="Search department..." />

        <TableView fx:id="deptTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Department Name" />
                <TableColumn fx:id="colHead" text="Head of Dept." />
                <TableColumn fx:id="colLoc" text="Office Location" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
            <Label text="Add New Department" textFill="#4a148c"><font><Font name="System Bold" size="18.0" /></font></Label>
            <GridPane hgap="15" vgap="10">
                <children>
                    <TextField fx:id="deptNameField" promptText="Name" GridPane.columnIndex="0" />
                    <TextField fx:id="deptHeadField" promptText="Head" GridPane.columnIndex="1" />
                    <TextField fx:id="deptLocField" promptText="Location" GridPane.columnIndex="2" />
                </children>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#onClearDept" text="Clear" />
                <Button onAction="#onSaveDept" style="-fx-background-color: #4a148c; -fx-text-fill: white;" text="Save Department" />
            </HBox>
        </VBox>
    </children>
</VBox>